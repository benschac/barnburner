    "anti-slop-effect/no-manual-tag-comparison": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/no-manual-tagged-construction": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/no-manual-tagged-type": [
      "error",
