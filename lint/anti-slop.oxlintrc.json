    "anti-slop-effect/no-service-parameters": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/no-static-effect-service-forwarders": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/no-test-code-in-src": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/no-unbounded-retry": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/prefer-tagged-error-handling": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/prefer-yield-service": [
      "error",
