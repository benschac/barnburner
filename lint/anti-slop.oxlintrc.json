{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "../tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "../tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "anti-slop-martinfowler",
      "specifier": "../tools/oxlint/anti-slop/martinfowler/index.ts"
    },
    {
      "name": "landmines",
      "specifier": "../tools/oxlint/anti-slop/plugins/landmines.ts"
    },
    {
      "name": "ai-guard",
      "specifier": "../tools/oxlint/anti-slop/plugins/ai-guard.ts"
    },
    {
      "name": "enfect",
      "specifier": "../tools/oxlint/anti-slop/plugins/enfect.ts"
    }
  ],
  "rules": {
    "complexity": [
      "warn",
      {
        "max": 15
      }
    ],
    "anti-slop/max-ternary-depth": [
      "error",
      {
        "mode": "changed",
        "maxDepth": 2
      }
    ],
    "anti-slop/no-array-filter-map": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-reduce-accumulator-copy": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-chained-type-assertions": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-conditional-spread": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-dev-env-branch": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-disabled-type-assertion-rules": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-instanceof": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-known-value-widening": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-module-mocking": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-object-parameters": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-reflect-apply": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-reflect-get": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-reprovide-ambient-service": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-unsafe-dictionary-type": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-shape-in-symbol-names": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-unknown-parameters": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-unknown-returns": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-unknown-type-aliases": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/no-widen-then-assert": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop/require-safety-comment-for-type-assertion": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect/no-manual-effect-error-tag": [
      "error",
      {
        "mode": "changed"
      }
