    "ai-guard/no-undeclared-import": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "ai-guard/no-silent-fallback": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/effect-promise-vs-trypromise": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/prefer-redacted-config": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/avoid-option-getorthrow": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/effect-run-in-body": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/no-cause-in-http-response": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/no-effect-ignore-then-as": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/avoid-expect-in-if": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/prefer-duration-constructors": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "enfect/avoid-mutable-state": [
      "error",
      {
        "mode": "changed"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "complexity": "off",
        "anti-slop-effect/throw-in-effect-gen": "off",
        "enfect/effect-promise-vs-trypromise": "off",
        "enfect/avoid-option-getorthrow": "off",
        "enfect/effect-run-in-body": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop-effect/no-manual-tagged-construction": "off",
        "anti-slop-effect/no-manual-tag-comparison": "off"
      }
    },
    {
      "files": [
        "**/src/main.ts",
        "**/scripts/**",
        "**/evals/run.ts",
        "**/app/**/page.tsx",
        "**/app/**/route.ts",
        "**/src/viz/frame/main.ts"
      ],
      "rules": {
        "enfect/effect-run-in-body": "off"
      }
    },
    {
      "files": ["**/src/use-*.ts", "**/src/tools/*.ts"],
      "rules": {
        "enfect/effect-run-in-body": "off"
      }
    },
    {
      "files": ["**/lint/**"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      "files": ["**/src/json.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    }
  ]
}
