{
  "name": "@nhl-reddit-stats/viz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/contracts.ts",
    "./samples": "./src/samples.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs@7.1.0-beta.tsrs3 --noEmit -p tsconfig.json",
    "lint": "bun run --parallel --no-exit-on-error lint:oxlint lint:errors lint:unions lint:core lint:index",
    "lint:oxlint": "node ../../tools/oxlint/anti-slop/modes/with-changes.ts effect-tsgo --tsrs-lint oxlint src tests",
    "lint:errors": "node ../../scripts/check-error-model.mjs src",
    "lint:unions": "node ../../scripts/test-union-rules.mjs .",
    "lint:core": "node ../../scripts/test-effect-core-rules.mjs .",
    "lint:index": "node ../../scripts/index-effect-core.mjs --check",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@nhl-reddit-stats/history": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
