{
  "name": "@nhl-reddit-stats/history",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/contracts.ts",
    "./contracts": "./src/contracts.ts",
    "./farthest": "./src/farthest.ts",
    "./finals": "./src/finals.ts",
    "./graph": "./src/graph.ts",
    "./paths": "./src/paths.ts",
    "./shapes": "./src/shapes.ts",
    "./store": "./src/store.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs@7.1.0-beta.tsrs3 --noEmit -p tsconfig.json",
    "lint": "bun run --parallel --no-exit-on-error lint:oxlint lint:errors lint:index",
    "lint:oxlint": "effect-tsgo --tsrs-lint oxlint src tests",
    "lint:errors": "node ../../scripts/check-error-model.mjs src",
    "lint:unions": "node ../../scripts/test-union-rules.mjs .",
    "lint:core": "node ../../scripts/test-effect-core-rules.mjs .",
    "lint:index": "node ../../scripts/index-effect-core.mjs --check",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
