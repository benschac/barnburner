{
  "name": "@nhl-reddit-stats/analyst",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs@7.1.0-beta.tsrs3 --noEmit -p tsconfig.json",
    "lint": "bun run --parallel --no-exit-on-error lint:oxlint lint:errors lint:index",
    "lint:oxlint": "effect-tsgo --tsrs-lint oxlint src tests evals scripts",
    "lint:errors": "node ../../scripts/check-error-model.mjs src",
    "lint:unions": "node ../../scripts/test-union-rules.mjs .",
    "lint:core": "node ../../scripts/test-effect-core-rules.mjs .",
    "lint:index": "node ../../scripts/index-effect-core.mjs --check",
    "test": "node --test \"tests/*.test.ts\" \"evals/*.test.ts\" \"evals/viz/*.test.ts\"",
    "ask": "node scripts/ask.ts",
    "insights:generate": "node scripts/generate-insights.ts",
    "insights:review": "node scripts/review-insights.ts",
    "insights:report": "node scripts/insights-report.ts",
    "insights:recheck": "node scripts/recheck-insights.ts",
    "evals": "node evals/run.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@nhl-reddit-stats/viz": "workspace:*",
    "ai": "7.0.173",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "1.65.1"
  }
}
