{
  "name": "@nhl-reddit-stats/analyst",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs@0.21.0-ts7.1.0-beta --noEmit -p tsconfig.json",
    "lint": "oxlint src tests evals scripts && node ../../scripts/check-error-model.mjs src && node ../../scripts/test-union-rules.mjs .",
    "test": "node --test \"tests/*.test.ts\" \"evals/*.test.ts\"",
    "ask": "node scripts/ask.ts",
    "insights:generate": "node scripts/generate-insights.ts",
    "insights:review": "node scripts/review-insights.ts",
    "insights:report": "node scripts/insights-report.ts",
    "insights:recheck": "node scripts/recheck-insights.ts",
    "evals": "node evals/run.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "ai": "7.0.173",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
