# Declared environment for nhl-reddit-stats. Values belong in gitignored .env.local.
# Agents never read .env.local; check resolution with `bun run env:check`.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Vercel AI Gateway key for the analyst's live model calls. Set a spend cap on it.
# @type=string
# @sensitive=true
AI_GATEWAY_API_KEY=

# Gateway "provider/model" overrides. Defaults live in packages/analyst/src/llm.ts.
# @type=string
# @sensitive=false
ANALYST_GENERATE_MODEL=

# @type=string
# @sensitive=false
ANALYST_RANK_MODEL=

# Overrides the data directory for `bun run ask`.
# @type=string
# @sensitive=false
ANALYST_DATA_DIR=
