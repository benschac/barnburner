{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "data/*.json",
    "lib/*.mjs",
    "lib/*.d.mts",
    "data/history/serving.json"
  ],
  "tasks": {
    "@nhl-reddit-stats/api#history:fetch": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "@nhl-reddit-stats/api#history:fetch"],
      "env": [
        "NODE_ENV",
        "SITE_URL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/viz-frame/**",
        "src/tamagui.generated.css"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "cache": false
    },
    "check:tamagui": {
      "cache": false
    },
    "generate:tamagui": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
