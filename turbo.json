{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["dist/**", "src/tamagui.generated.css", "node_modules/.tmp/*.tsbuildinfo"]
    },
    "typecheck": {
      "outputs": ["node_modules/.tmp/*.tsbuildinfo"]
    },
    "lint": {},
    "check:tamagui": { "cache": false },
    "generate:tamagui": { "cache": false },
    "dev": { "cache": false, "persistent": true },
    "preview": { "dependsOn": ["build"], "cache": false, "persistent": true }
  }
}
