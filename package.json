{
  "name": "nhl-reddit-stats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "data:refresh": "node scripts/refresh-nhl-games.mjs",
    "data:refresh:poster": "node scripts/refresh-nhl-poster.mjs",
    "data:serve": "node scripts/serve-nhl-games.mjs",
    "test:data": "node --test tests/nhl-games.test.mjs tests/nhl-poster.test.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check:tamagui": "turbo run check:tamagui",
    "generate:tamagui": "turbo run generate:tamagui",
    "lint": "turbo run lint",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
