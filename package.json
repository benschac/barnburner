{
  "name": "nhl-reddit-stats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "docs:plan": "bun run --cwd apps/web docs:plan",
    "typecheck:plan": "bun run --cwd apps/web typecheck:plan",
    "data:refresh": "node scripts/refresh-nhl-games.mjs",
    "data:refresh:poster": "node scripts/refresh-nhl-poster.mjs",
    "data:refresh:all": "node scripts/refresh-nhl-data.mjs",
    "data:import:history": "python3 scripts/import-nhl-history.py && python3 scripts/check_nhl_history.py --fetch && python3 scripts/build-nhl-history.py --refetch-recent",
    "data:import:dressed": "python3 scripts/import-nhl-dressed.py",
    "data:build:history": "python3 scripts/build-nhl-history.py",
    "data:build:serving": "python3 scripts/build-nhl-serving.py --base data/history/nhl.sqlite --out data/history/nhl-serve.sqlite",
    "data:serve": "node apps/api/src/main.ts",
    "test:data": "node --test tests/nhl-*.test.mjs",
    "test:api": "bun run --cwd apps/api test",
    "test:scripts": "node --test tests/land-stack.test.mjs",
    "land": "node scripts/land-stack.mjs",
    "test:history": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check:tamagui": "turbo run check:tamagui",
    "generate:tamagui": "turbo run generate:tamagui",
    "check:effect-api": "node scripts/refresh-effect-api.mjs --check && node scripts/index-effect-core.mjs --check",
    "check:xstate-docs": "node scripts/index-xstate-docs.mjs --check",
    "check:node-scripts": "oxlint -c lint/node-scripts.oxlintrc.json --report-unused-disable-directives-severity=error scripts lib",
    "lint:jev": "oxlint -c lint/anti-slop-jev.oxlintrc.json apps packages",
    "test:anti-slop": "node --test 'tools/oxlint/anti-slop/rules/{max,no,require-readable-spacing.,require-safety}*.test.ts' 'tools/oxlint/anti-slop/{effect,martinfowler}/rules/*.test.ts' tools/oxlint/anti-slop/jev/effect-rules.test.ts tools/oxlint/anti-slop/martinfowler/jev-rules.test.ts 'tools/oxlint/anti-slop/diff-rules/{git,input,runner}.test.ts' tools/oxlint/anti-slop/modes/wrap.test.ts tools/oxlint/anti-slop/modes/with-changes.test.ts",
    "lint": "bun run check:effect-api && bun run check:xstate-docs && bun run check:node-scripts && turbo run lint",
    "preview": "turbo run preview",
    "ask": "varlock run -- bun run --cwd packages/analyst ask",
    "insights:generate": "varlock run -- bun run --cwd packages/analyst insights:generate",
    "insights:review": "bun run --cwd packages/analyst insights:review",
    "insights:report": "bun run --cwd packages/analyst insights:report",
    "insights:recheck": "bun run --cwd packages/analyst insights:recheck",
    "evals": "varlock run -- bun run --cwd packages/analyst evals",
    "env:check": "varlock load --agent",
    "history:accept": "bun run --cwd apps/api history:accept",
    "history:query": "bun run --cwd apps/api history:query"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "oxlint": "1.91.0",
    "turbo": "2.11.10",
    "@effect/tsgo": "0.67.1",
    "@oxlint/plugins": "1.91.0",
    "@interfere/landmines": "0.1.1",
    "eslint-plugin-ai-guard": "1.4.7",
    "@typescript-eslint/parser": "8.73.0",
    "@enfect/oxlint": "0.10.0",
    "oxlint-plugin-jev": "file:./tools/oxlint/oxlint-plugin-jev",
    "varlock": "1.23.0"
  }
}
