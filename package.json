{
  "name": "nhl-reddit-stats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "data:refresh": "node scripts/refresh-nhl-games.mjs",
    "data:refresh:poster": "node scripts/refresh-nhl-poster.mjs",
    "data:refresh:all": "node scripts/refresh-nhl-data.mjs",
    "data:serve": "node apps/api/src/main.ts",
    "test:data": "node --test tests/nhl-*.test.mjs",
    "test:api": "bun run --cwd apps/api test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check:tamagui": "turbo run check:tamagui",
    "generate:tamagui": "turbo run generate:tamagui",
    "lint": "turbo run lint",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "@effect/tsgo": "0.67.1"
  }
}
