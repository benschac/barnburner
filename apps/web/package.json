{
  "name": "@nhl-reddit-stats/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check:tamagui": "tamagui check --strict",
    "generate:tamagui": "tamagui generate-prompt",
    "lint": "oxlint && node scripts/check-design-files.mjs && node scripts/test-design-rules.mjs && node scripts/test-pattern-rules.mjs",
    "preview": "vite preview",
    "test:design": "node scripts/test-design-rules.mjs",
    "test:teams": "node --test tests/team-season.test.ts tests/team-machine.test.ts"
  },
  "dependencies": {
    "@nhl-reddit-stats/season": "0.0.0",
    "@tamagui/config": "3.3.1",
    "@xstate/effect": "1.0.0-alpha.12",
    "effect": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tamagui": "3.3.1",
    "xstate": "6.0.0-alpha.73"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@tamagui/cli": "3.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
