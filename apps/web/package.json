{
  "name": "@nhl-reddit-stats/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "docs:plan": "bun scripts/build-analyst-plan.ts",
    "typecheck:plan": "effect-tsgo tsrs@0.21.0-ts7.1.0-beta --noEmit -p tsconfig.plan.json",
    "dev": "vite",
    "build": "bun run --cwd ../api build && bun run typecheck && vite build",
    "typecheck": "effect-tsgo tsrs@0.21.0-ts7.1.0-beta --noEmit -p tsconfig.app.json && effect-tsgo tsrs@0.21.0-ts7.1.0-beta --noEmit -p tsconfig.node.json",
    "check:tamagui": "tamagui check --strict",
    "generate:tamagui": "tamagui generate-prompt",
    "lint": "effect-tsgo --tsrs-lint oxlint && node scripts/check-design-files.mjs && node scripts/test-design-rules.mjs && node scripts/test-pattern-rules.mjs && node ../../scripts/check-error-model.mjs plan-viewer/plan.ts",
    "preview": "vite preview",
    "next:dev": "next dev --webpack",
    "next:build": "next build --webpack",
    "test:design": "node scripts/test-design-rules.mjs",
    "test:teams": "node --test tests/team-season.test.ts tests/team-machine.test.ts tests/boxscore-machine.test.ts tests/game-inspection.test.ts",
    "test:social": "node --test tests/social-*.test.ts",
    "test:plan": "node --test tests/plan-parse.test.ts"
  },
  "dependencies": {
    "@antv/g-webgl": "2.1.3",
    "@antv/g2": "5.4.8",
    "@antv/g6": "5.1.1",
    "@antv/g6-extension-react": "0.2.7",
    "@cosmos.gl/graph": "3.6.0",
    "@effect/atom-react": "4.1.2",
    "@nhl-reddit-stats/api": "0.0.0",
    "@nhl-reddit-stats/history": "workspace:*",
    "@nhl-reddit-stats/season": "0.0.0",
    "@nhl-reddit-stats/viz": "workspace:*",
    "@tamagui/config": "3.3.1",
    "@tamagui/next-plugin": "3.3.1",
    "@vercel/analytics": "^2.0.1",
    "@xstate/effect": "1.0.0-alpha.12",
    "d3": "7.9.2",
    "effect": "4.1.2",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tamagui": "3.3.1",
    "three": "0.187.0",
    "xstate": "6.0.0-alpha.73"
  },
  "devDependencies": {
    "@content-collections/core": "0.15.3",
    "@content-collections/mdx": "0.2.2",
    "@oxlint/plugins": "1.90.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tamagui/cli": "3.3.1",
    "@types/d3": "7.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "1.91.0",
    "playwright": "1.65.1",
    "remark-gfm": "4.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
