{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "app/api/history/route.ts": { "supportsCancellation": true, "maxDuration": 60 },
    "app/api/{rpc,games,poster,teams}/route.ts": { "supportsCancellation": true },
    "app/api/[[...path]]/route.ts": { "supportsCancellation": true }
  }
}
