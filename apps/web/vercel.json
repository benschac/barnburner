{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/{games,poster,rpc,teams}.ts": {
      "supportsCancellation": true
    },
    "api/history.ts": {
      "supportsCancellation": true,
      "includeFiles": "history-data/nhl-serve.sqlite"
    }
  }
}
