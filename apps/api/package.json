{
  "name": "@nhl-reddit-stats/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./web-handler": {
      "types": "./src/web-handler.ts",
      "default": "./dist/web-handler.js"
    },
    "./history-handler": {
      "types": "./src/history-handler.ts",
      "default": "./dist/history-handler.js"
    }
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "bun scripts/build.mjs",
    "start": "node src/main.ts",
    "history:accept": "node scripts/history-accept.ts",
    "history:fetch": "node scripts/fetch-history.ts",
    "history:query": "node scripts/history-query.ts",
    "typecheck": "effect-tsgo tsrs@0.21.0-ts7.1.0-beta --noEmit -p tsconfig.json",
    "lint": "node ../../tools/oxlint/anti-slop/modes/with-changes.ts effect-tsgo --tsrs-lint oxlint src tests scripts && node ../../scripts/check-error-model.mjs scripts/fetch-history.ts && node ../../scripts/test-effect-core-rules.mjs . && node ../../scripts/index-effect-core.mjs --check",
    "test": "bun run build && node --test tests/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "@nhl-reddit-stats/analyst": "0.0.0",
    "@nhl-reddit-stats/history": "workspace:*",
    "@nhl-reddit-stats/viz": "workspace:*",
    "@nhl-reddit-stats/season": "0.0.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2"
  }
}
